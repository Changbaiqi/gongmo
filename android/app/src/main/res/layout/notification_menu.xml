<?xml version="1.0" encoding="utf-8"?>
<!-- 「截屏记账」常驻通知布局：仅一行图标按钮并占满内容区。
     不放标题/说明文字，避免通知高度超限被系统裁断显示不全 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notify_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/notify_capture"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/notification_action_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@string/notification_action_capture"
            android:src="@drawable/ic_notify_capture" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:text="@string/notification_action_capture"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notify_photo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/notification_action_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@string/notification_action_photo"
            android:src="@drawable/ic_notify_photo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:text="@string/notification_action_photo"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notify_open"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/notification_action_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@string/notification_action_open"
            android:src="@drawable/ic_notify_open" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:text="@string/notification_action_open"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notify_stop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/notification_action_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@string/notification_action_stop"
            android:src="@drawable/ic_notify_close" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:text="@string/notification_action_stop"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
