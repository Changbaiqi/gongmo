<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+：Android 12 系统开屏使用粉白底 -->
    <style name="GmBaseTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:colorBackground">@color/gm_background</item>
        <item name="android:statusBarColor">@color/gm_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/gm_background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/gm_background</item>
    </style>

    <style name="LaunchTheme" parent="GmBaseTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="GmBaseTheme">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
